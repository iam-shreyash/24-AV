# For psycopg3 (recommended for Python 3.14+)
DATABASE_URL=postgresql+psycopg://crm_user:6648@localhost:5432/private_plane_crm
# Alternative: postgresql+psycopg2://crm_user:6648@localhost:5432/private_plane_crm (for psycopg2)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600
# Payment Gateway API Keys (can be managed via Admin Panel)
STRIPE_SECRET_KEY=sk_test_change
STRIPE_PUBLISHABLE_KEY=pk_test_change
RAZORPAY_KEY_ID=rzp_test_change
RAZORPAY_KEY_SECRET=rzp_secret_change
PAYPAL_CLIENT_ID=paypal_client_id_change
PAYPAL_CLIENT_SECRET=paypal_client_secret_change

# Optional API Keys
OTP_SERVICE_KEY=otp_service_key_change
AVIATIONSTACK_API_KEY=aviationstack_key_change
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
REDIS_URL=redis://localhost:6379/0
ADMIN_DEFAULT_EMAIL=admin@privateplane.app
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# External Flight API Configuration (Optional)
# Set to "true" to enable fetching flights from external APIs
ENABLE_EXTERNAL_FLIGHT_API=false
# Get your API key from https://aviationstack.com (Free tier: 100 requests/month)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# SMS/OTP Service Configuration
# Options: "dev" (development - just logs OTP), "twilio", or "msg91"
SMS_PROVIDER=dev

# Twilio Configuration (Free trial: $15.50 credit, ~1000 SMS)
# Sign up at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Configuration (Popular in India, free trial available)
# Sign up at https://msg91.com/
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=OTPMSG
MSG91_TEMPLATE_ID=  # Optional: if you have an approved template

